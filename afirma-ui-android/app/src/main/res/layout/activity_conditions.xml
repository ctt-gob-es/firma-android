<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/conditions_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/conditionsToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ToolbarTheme"
        app:popupTheme="@style/AppTheme">

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/acceptance_conditions"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:ellipsize="none"
            android:singleLine="false"
            android:theme="@style/ToolbarTitle"
            android:maxLines="3"
        />

    </com.google.android.material.appbar.MaterialToolbar>


    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/language_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:layout_marginTop="20dp"
        android:background="@color/white"
        android:orientation="horizontal">

    <TextView
        android:id="@+id/langTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:fontFamily="@font/nunitosansbold"
        android:text="@string/language"
        android:textColor="@color/black"
        android:textSize="15sp" />

        <Spinner
            android:id="@+id/spinner_languages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:layout_marginLeft="10dp"
            android:background="@drawable/spinner_black_border"/>

    </LinearLayout>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fadeScrollbars="false"
        android:scrollbars="vertical"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbarFadeDuration="50000"
        android:scrollbarThumbVertical="@android:color/black"
        android:padding="10dp"
        android:layout_margin="15dp"
        android:layout_weight="0.30"
        android:background="@drawable/gray_borders">

        <WebView
            android:id="@+id/contentConditionsWv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:fontFamily="@font/nunitosans"
            android:textColor="@color/black" />

    </ScrollView>


    <CheckBox
        android:id="@+id/readAndAcceptPrivacyChk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/option_selector"
        android:textColor="@color/black"
        android:fontFamily="@font/nunitosans"
        app:buttonTint="@color/black"
        android:text="@string/read_and_accept_privacy"
        />

    <CheckBox
        android:id="@+id/readAndAcceptLegalChk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/option_selector"
        android:textColor="@color/black"
        android:fontFamily="@font/nunitosans"
        app:buttonTint="@color/black"
        android:text="@string/read_and_accept_legal"
        />

    <Button
        android:id="@+id/acceptConditionsBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/nunitosans"
        android:textStyle="bold"
        android:textColor="#767676"
        android:onClick="onClick"
        android:enabled="false"
        android:text="@string/ok"
        android:textAllCaps="false"
        android:background="@drawable/btn_red_large_states" />

</LinearLayout>