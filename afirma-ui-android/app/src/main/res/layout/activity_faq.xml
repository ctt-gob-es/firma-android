<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/permissions_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:touchscreenBlocksFocus="false"
    android:background="@color/white"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/faqToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ToolbarTheme"
        app:navigationIcon="@drawable/nav_back_selector"
        app:popupTheme="@style/AppTheme">

        <TextView
            android:id="@+id/faqToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/faq"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:ellipsize="none"
            android:singleLine="false"
            android:theme="@style/ToolbarTitle"
            android:maxLines="3"
            />

    </com.google.android.material.appbar.MaterialToolbar>

    <ExpandableListView
        android:id="@+id/faqLV"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/toolbar"
        android:listSelector="@drawable/option_selector"
        android:choiceMode="none"
        android:importantForAccessibility="yes"
        android:dividerHeight="1dp" />

</LinearLayout>