<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <TextView
        android:id="@+id/presentationTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:gravity="center"
        android:text="@string/presentation_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:fontFamily="@font/merriweatherbold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textView1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/presentation_text"
        android:textColor="#56636D"
        android:fontFamily="@font/nunitosans"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/presentationTitle"
        app:layout_constraintBottom_toTopOf="@id/selectOptionTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/selectOptionTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:gravity="center"
        android:text="@string/accesibility_select_option"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:fontFamily="@font/merriweatherbold"
        app:layout_constraintBottom_toTopOf="@id/buttonSign"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/buttonSign"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sign_file"
        style="@style/ButtonRedLarge"
        app:layout_constraintTop_toBottomOf="@id/selectOptionTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/spacer"
        android:layout_width="0dp"
        android:layout_height="8dp"
        app:layout_constraintTop_toBottomOf="@id/buttonSign"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/importCertButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/add_new_cert"
        style="@style/ButtonWhiteLarge"
        app:layout_constraintTop_toBottomOf="@id/spacer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
