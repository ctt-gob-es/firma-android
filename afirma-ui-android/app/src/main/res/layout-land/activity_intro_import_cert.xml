<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/importCertToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:theme="@style/ToolbarTheme"
        android:touchscreenBlocksFocus="false"
        app:navigationIcon="@drawable/nav_back_selector"
        app:popupTheme="@style/AppTheme" />

    <LinearLayout
        android:id="@+id/contentInfo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/merriweatherbold"
            android:paddingLeft="20dp"
            android:paddingTop="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="5dp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/introText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunitosans"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textColor="#56636D" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/containerVp"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_weight="0"
            android:gravity="bottom"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/page1Indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:layout_margin="5dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/selectedpageindicator" />

                <ImageView
                    android:id="@+id/page2Indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:layout_margin="5dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/unselectedpageindicator" />

            </LinearLayout>

            <Button
                android:id="@+id/continueButton"
                style="@style/ButtonRedLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="11dp"
                android:nextFocusForward="@+id/drawer_layout"
                android:onClick="onClick"
                android:text="@string/drag_on" />

            <Button
                android:id="@+id/importCertButton"
                style="@style/ButtonRedLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="11dp"
                android:nextFocusForward="@+id/drawer_layout"
                android:onClick="onClick"
                android:text="@string/add_cert"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
